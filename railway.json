{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "python src/manage.py collectstatic --noinput"
  },
  "deploy": {
    "preDeployCommand": ["python src/manage.py migrate --noinput"],
    "startCommand": "gunicorn --chdir src config.wsgi --bind 0.0.0.0:$PORT --workers 2",
    "healthcheckPath": "/saude/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE"
  }
}
