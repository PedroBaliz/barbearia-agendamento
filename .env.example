# Copie para .env e ajuste. Nunca commite o .env.

# Em desenvolvimento use DEBUG=true; em produção, false.
DEBUG=true

# Obrigatória em produção. Gere com:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Hosts aceitos (separados por vírgula). Em produção: o domínio do Railway.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para formulários (produção): https://seu-app.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Sem DATABASE_URL, usa SQLite local (src/db.sqlite3).
# Produção (Railway): postgresql://usuario:senha@host:5432/banco
DATABASE_URL=
