# Copie para .env e ajuste. Nunca commite o .env.

# Em desenvolvimento use DEBUG=true; em produção, false.
DEBUG=true

# Obrigatória em produção. Gere com:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Hosts aceitos (separados por vírgula). Na Vercel, *.vercel.app já é aceito automaticamente;
# adicione aqui só um domínio próprio.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para formulários (produção, domínio próprio): https://seu-dominio.com.br
# Na Vercel, https://*.vercel.app já é aceito automaticamente.
CSRF_TRUSTED_ORIGINS=

# Local (recomendado, ADR 0003): PostgreSQL com usuário e banco barbearia. Passo a passo em docs/ambiente.md.
#   DATABASE_URL=postgresql://barbearia:barbearia@localhost:5432/barbearia
# Sem DATABASE_URL, usa SQLite local (src/db.sqlite3).
# Produção (Vercel Storage / Neon, preenchida automaticamente): postgresql://usuario:senha@host:5432/banco
DATABASE_URL=
